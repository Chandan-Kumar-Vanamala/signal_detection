# Copy this file to .env and fill in the real values.
# .env is never committed or shared (see .gitignore).

# OpenAI API key - from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which OpenAI model reads the timelines and detects the signals.
# gpt-6-luna: small and cheap ($0.05 in / $0.25 out per 1M tokens on flex), and
# far more reliable here than gpt-5-nano, which missed clear signals.
OPENAI_MODEL=gpt-6-luna
